{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISHWE QuickNote",
  "version": "0.2.0",
  "identifier": "com.ishwe.quicknote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ISHWE QuickNote",
        "url": "index.html",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true,
        "alwaysOnTop": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Fast task capture for ISHWE",
    "longDescription": "A lightweight Tauri 2 desktop client for the ISHWE Eisenhower matrix task manager. Capture tasks from anywhere with a global hotkey."
  }
}
